{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "redline-qr-lab",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://mubeen97.github.io"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SIGNAL_ROOM", "class_name": "SignalRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }
  ]
}
